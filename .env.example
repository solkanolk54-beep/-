# ==============================================================================
# منظومة كَرِيمَة للرقابة الشاملة والشفافية الرقمية (Kareema Platform)
# بيئة الإنتاج السحابي الآمنة (Cloud Production Environment Template)
# ==============================================================================

# 1. Gemini AI Diagnostic Engine (Injected by Cloud Run / Secret Manager)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. Host Application URL (Injected by Cloud Run)
APP_URL="MY_APP_URL"
NODE_ENV="production"
PORT=3000

# 3. PostgreSQL 16 + PostGIS 3.4 (Enforced TLS / SSL Connection)
# sslmode=verify-full or sslmode=require ensures encrypted data-in-transit
DATABASE_URL="postgres://kareema_admin:MY_SECURE_DB_PASSWORD@db:5432/kareema_platform?sslmode=require"
DB_USER="kareema_admin"
DB_PASSWORD="MY_SECURE_DB_PASSWORD"
DB_NAME="kareema_platform"
DB_SSL_CA="/etc/ssl/certs/kareema-root-ca.crt"

# 4. Redis 7 High-Throughput In-Memory Cache & Message Broker (Enforced TLS: rediss://)
# Protocol 'rediss://' (with double s) activates TLS 1.3 encapsulation
REDIS_URL="rediss://:MY_SUPER_SECURE_REDIS_AUTH_KEY@redis:6380/0"
REDIS_PASSWORD="MY_SUPER_SECURE_REDIS_AUTH_KEY"
REDIS_PORT=6380
REDIS_TLS_ENABLED="true"
REDIS_TLS_CA_CERT="/etc/ssl/certs/redis-ca.pem"
REDIS_TLS_CERT="/etc/ssl/certs/redis-client.pem"
REDIS_TLS_KEY="/etc/ssl/certs/redis-client-key.pem"

# 5. Cryptographic Security & RBAC Tokens
JWT_SECRET="MY_ENTERPRISE_JWT_SOVEREIGN_SECRET_KEY_MIN_32_BYTES"
JWT_EXPIRATION="8h"
CIPHER_ALGORITHM="aes-256-gcm"

# 6. TLS 1.3 Termination & Gateway
TLS_CERT_PATH="/etc/ssl/certs/kareema-domain.crt"
TLS_KEY_PATH="/etc/ssl/private/kareema-domain.key"
MIN_TLS_VERSION="TLSv1.3"

